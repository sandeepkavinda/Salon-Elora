# Copy to .env and fill in. Never commit .env.

PORT=5174
# Comma-separated list of allowed browser origins (the site's public URL in production)
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy / load balancer so rate limiting sees real client IPs
TRUST_PROXY=0

# SMTP provider (Gmail app password, Zoho, Brevo, Mailgun, your host's SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Address that RECEIVES customer enquiries
CONTACT_TO=salon-inbox@your-domain.example
# Sender shown on emails (must be allowed by your SMTP provider)
MAIL_FROM=hello@your-domain.example
